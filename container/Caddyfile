{
	admin off
	auto_https off
	persist_config off
}

:{$SAGEMAKER_PORT:8080} {
	# SageMaker health check — returns 200 only once NIM has loaded the model.
	handle /ping {
		rewrite * /v1/health/ready
		reverse_proxy localhost:{$NIM_SERVER_PORT:8000}
	}

	# SageMaker inference (InvokeEndpoint and InvokeEndpointWithResponseStream).
	handle /invocations {
		rewrite * /v1/chat/completions
		reverse_proxy localhost:{$NIM_SERVER_PORT:8000} {
			# Flush immediately so streamed (SSE) tokens are not buffered.
			flush_interval -1
		}
	}

	handle {
		respond "Not Found" 404
	}
}
