{
	admin off
	auto_https off
}

:8080 {
	# SageMaker health check -> NIM readiness probe
	handle /ping {
		rewrite * /v1/health/ready
		reverse_proxy 127.0.0.1:8000
	}

	# SageMaker inference -> NIM OpenAI-compatible chat completions.
	# flush_interval -1 keeps token streaming (InvokeEndpointWithResponseStream) working.
	handle /invocations {
		rewrite * /v1/chat/completions
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
			transport http {
				read_timeout 0
			}
		}
	}

	handle {
		respond "Not Found" 404
	}
}
