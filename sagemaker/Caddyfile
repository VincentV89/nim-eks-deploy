{
	admin off
	auto_https off
}

:8080 {
	handle /ping {
		rewrite * /v1/health/ready
		reverse_proxy 127.0.0.1:8000
	}

	# /invocations accepts an OpenAI chat-completions request body
	handle /invocations {
		rewrite * /v1/chat/completions
		reverse_proxy 127.0.0.1:8000 {
			# stream tokens through for InvokeEndpointWithResponseStream
			flush_interval -1
		}
	}

	handle {
		respond "Not Found" 404
	}
}
