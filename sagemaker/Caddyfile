# Map the SageMaker container contract onto the NIM OpenAI-compatible API.
{
	admin off
	auto_https off
}

:8080 {
	# SageMaker health check -> NIM readiness (returns 503 until the
	# TensorRT-LLM engine is loaded, which keeps traffic off the instance).
	handle /ping {
		rewrite * /v1/health/ready
		reverse_proxy 127.0.0.1:8000
	}

	# SageMaker InvokeEndpoint -> OpenAI-style chat completions.
	handle /invocations {
		rewrite * /v1/chat/completions
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
		}
	}

	handle {
		respond "Not Found" 404
	}
}
