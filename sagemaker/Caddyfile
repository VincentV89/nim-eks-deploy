# SageMaker hosting contract -> NIM OpenAI-compatible API.
#
#   SageMaker (port 8080)        NIM (port 8000, proxied via 127.0.0.1)
#   GET  /ping            ->     GET  /v1/health/ready   (200 only once the model is loaded)
#   POST /invocations     ->     POST /v1/chat/completions
#
# Only the chat-completions request format is supported through /invocations.
{
	admin off
	auto_https off
}

:8080 {
	handle /ping {
		rewrite * /v1/health/ready
		reverse_proxy 127.0.0.1:8000
	}

	handle /invocations {
		rewrite * /v1/chat/completions
		reverse_proxy 127.0.0.1:8000 {
			# Pass streamed tokens through immediately (InvokeEndpointWithResponseStream).
			flush_interval -1
		}
	}

	handle {
		respond 404
	}
}
