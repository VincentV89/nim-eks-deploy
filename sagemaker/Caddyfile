{
	admin off
	auto_https off
}

:8080 {
	handle /ping {
		rewrite * /v1/health/ready
		reverse_proxy 127.0.0.1:8000
	}

	handle /invocations {
		rewrite * /v1/chat/completions
		reverse_proxy 127.0.0.1:8000 {
			# Pass server-sent events straight through for streaming responses.
			flush_interval -1
		}
	}

	handle {
		respond 404
	}
}
